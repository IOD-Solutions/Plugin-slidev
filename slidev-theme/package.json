{
  "name": "@iod-solutions/slidev-theme",
  "version": "0.2.0",
  "description": "IoD solutions branded Slidev theme (cyan/white identity)",
  "main": "index.js",
  "keywords": [
    "slidev-theme",
    "slidev",
    "iod"
  ],
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IOD-Solutions/Plugin-slidev.git",
    "directory": "slidev-theme"
  },
  "engines": {
    "slidev": ">=0.43.0"
  },
  "slidev": {
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1000,
      "colorSchema": "light",
      "fonts": {
        "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
        "mono": "JetBrains Mono, ui-monospace, monospace",
        "weights": "400,500,600,700"
      }
    }
  },
  "files": [
    "layouts/",
    "components/",
    "styles/",
    "assets/",
    "README.md"
  ]
}
