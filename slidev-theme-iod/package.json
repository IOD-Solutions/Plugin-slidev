{
  "name": "slidev-theme-iod",
  "version": "0.1.0",
  "description": "IoD solutions branded Slidev theme (cyan/white identity)",
  "main": "index.js",
  "keywords": [
    "slidev-theme",
    "slidev",
    "iod"
  ],
  "engines": {
    "slidev": ">=0.43.0"
  },
  "slidev": {
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1000,
      "colorSchema": "light",
      "fonts": {
        "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
        "mono": "JetBrains Mono, ui-monospace, monospace",
        "weights": "400,500,600,700"
      }
    }
  },
  "files": [
    "layouts/",
    "components/",
    "styles/",
    "public/",
    "README.md"
  ]
}
